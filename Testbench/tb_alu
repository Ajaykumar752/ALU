`timescale 1ns / 1ps
module tb_alu;
reg  [3:0] a,b;
reg  [3:0] alu_sel;
wire [3:0] x,y;

alu uut(.a(a),
.b(b),
.alu_sel(alu_sel),
.x(x),
.y(y));

initial begin
a=4'b1010;      //let take input a = 1010 which is 10 in decimal 
b=4'b0010;      // let take input b=0010 which is 2 in decimal
                //with this we do all the logic calculation in ALU
    alu_sel=4'b0000; 
    #10; //Addition 
    
    alu_sel=4'b0001; 
    #10; //SUBTRACTION
    
    alu_sel=4'b0010; 
    #10; //MULTIPLICAION
    
    alu_sel=4'b0011; 
    #10; //DIVISION
    
    alu_sel=4'b0100; 
    #10; //BITWISE NOT
    
    alu_sel=4'b0101; 
    #10; //BITWISE OR
    
    alu_sel=4'b0110; 
    #10; //BITWISE AND
    
    alu_sel=4'b0111; 
    #10; //BITWISE XOR
    
    alu_sel=4'b1000; 
    #10; //REDUCTION OR
    
    alu_sel=4'b1001; 
    #10; //REDUCTION AND
    
    alu_sel=4'b1010; 
    #10; //LOGICAL XOR
    
    alu_sel=4'b1011; 
    #10; //LOGICAL NOT
    
    alu_sel=4'b1100; 
    #10; //EQUALITY CHECK
    
    alu_sel=4'b1101; 
    #10; //8-BIT MULTIPLICATION
    
    alu_sel=4'b1110; 
    #10; //LEFT SHIFT
    
    alu_sel=4'b1111; 
    #10; //RIGHT SHIFT
    $finish;
    
    end
    initial begin
    $monitor("Time=%0t| alu_sel=%b | a=%b |b=%b | x=%b | y=%b",$time,alu_sel,a,b,x,y);
  end
endmodule
